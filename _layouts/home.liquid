<!doctype html>
<html lang="{{ site.lang }}">
  <head>
    {% include head.liquid %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    >
  </head>

  <body class="home-page {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <script>
      document.documentElement.classList.add('js');
    </script>

    <!-- Minimal header: name, in-page anchors, theme toggle -->
    <header class="site-header">
      <div class="container site-nav">
        <a class="site-name" href="{{ '/' | relative_url }}">
          {{- site.first_name }}
          {{ site.last_name -}}
        </a>
        <nav class="site-links" aria-label="Sections">
          <a href="#news">News</a>
          <a href="#experience">Experience</a>
          <a href="#publications">Publications</a>
          <a href="#manuscripts">Manuscripts</a>
          {% if site.data.patents and site.data.patents.size > 0 %}
            <a href="#patents">Patents</a>
          {% endif %}
          {% if site.data.talks and site.data.talks.size > 0 %}
            <a href="#talks">Talks</a>
          {% endif %}
          {% if site.enable_darkmode %}
            <button id="light-toggle" title="Change theme" aria-label="Change theme">
              <i class="ti ti-sun-moon" id="light-toggle-system"></i>
              <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
              <i class="ti ti-sun-filled" id="light-toggle-light"></i>
            </button>
          {% endif %}
        </nav>
      </div>
    </header>

    <main class="container home" role="main">
      <!-- Hero -->
      <section id="about" class="hero reveal">
        {% if page.photo %}
          <img
            class="hero-photo"
            src="{{ page.photo | prepend: '/assets/img/' | relative_url }}"
            alt="Photo of {{ site.first_name }} {{ site.last_name }}"
            loading="eager"
          >
        {% endif %}
        <div class="hero-text">
          <h1 class="hero-name">
            {{ site.first_name }}
            {{ site.middle_name }}
            {{ site.last_name }}
          </h1>
          {% if page.role %}
            <p class="hero-role">
              {% if page.role_logo %}
                <img class="role-logo" src="{{ page.role_logo | prepend: '/assets/img/' | relative_url }}" alt="">
              {% endif %}
              <span>{{ page.role }}</span>
            </p>
          {% endif %}
          {% if page.location %}
            <p class="hero-location" title="{{ page.location }}">
              {% include icons/golden_gate.liquid %}
              <span>{{ page.location }}</span>
            </p>
          {% endif %}
          <div class="hero-bio">{{ content }}</div>
          {% if page.email_user and page.email_domain %}
            <p class="hero-contact">
              <i class="fa-solid fa-envelope"></i>
              <a
                class="email-reveal"
                href="#"
                data-user="{{ page.email_user }}"
                data-domain="{{ page.email_domain }}"
                title="Hover to reveal"
              >
                {{- page.email_text | default: 'hover to reveal email' -}}
              </a>
            </p>
          {% endif %}
          <div class="hero-social">{% include social.liquid %}</div>
        </div>
      </section>

      <!-- News: two most recent visible, the rest behind a toggle -->
      {% if site.data.news and site.data.news.size > 0 %}
        {% assign news_visible = 2 %}
        {% assign news_hidden = site.data.news.size | minus: news_visible %}
        <section id="news" class="home-section reveal">
          <h2 class="section-title">News</h2>
          <ul class="news-list">
            {% for item in site.data.news limit: news_visible %}
              <li>
                <span class="date">{{ item.date }}</span>
                <span class="text">{{ item.text }}</span>
              </li>
            {% endfor %}
          </ul>
          {% if news_hidden > 0 %}
            <div class="collapsible" id="news-more">
              <ul class="news-list">
                {% for item in site.data.news offset: news_visible %}
                  <li>
                    <span class="date">{{ item.date }}</span>
                    <span class="text">{{ item.text }}</span>
                  </li>
                {% endfor %}
              </ul>
            </div>
            <button
              class="toggle-pill"
              type="button"
              data-toggle="#news-more"
              data-label-open="Show less"
              aria-expanded="false"
              aria-controls="news-more"
            >
              <span class="toggle-label">Show {{ news_hidden }} more</span>
              <i class="ti ti-chevron-down chev"></i>
            </button>
          {% endif %}
        </section>
      {% endif %}

      <!-- Experience -->
      {% if site.data.resume.work and site.data.resume.work.size > 0 %}
        <section id="experience" class="home-section reveal">
          <h2 class="section-title">Experience</h2>
          <ul class="experience-list">
            {% assign work = site.data.resume.work | sort: 'startDate' | reverse %}
            {% for job in work %}
              {% assign s = job.startDate | split: '-' %}
              {% assign start = s[0] | append: '-' | append: s[1] | append: '-01' | date: '%b %Y' %}
              {% if job.endDate %}
                {% assign e = job.endDate | split: '-' %}
                {% assign end = e[0] | append: '-' | append: e[1] | append: '-01' | date: '%b %Y' %}
              {% else %}
                {% assign end = 'Present' %}
              {% endif %}
              <li class="experience-item">
                <div class="logo-chip">
                  {% if job.logo %}
                    <img src="{{ job.logo | relative_url }}" alt="{{ job.name }} logo">
                  {% endif %}
                </div>
                <div class="experience-body">
                  <div class="experience-role">{{ job.position }}</div>
                  <div class="experience-org">
                    {{ job.name -}}
                    {%- if job.location -%}
                      <span class="sep">·</span>{{ job.location -}}
                    {%- endif %}
                  </div>
                </div>
                <div class="experience-dates">{{ start }} – {{ end }}</div>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      <!-- Publications -->
      <section id="publications" class="home-section reveal">
        <h2 class="section-title">Publications</h2>
        {% include bib_search.liquid %}
        <div class="publications">
          {% bibliography --query @inproceedings || @article %}

          <h3 class="section-subtitle" id="manuscripts">Manuscripts</h3>
          {% bibliography --query @unpublished %}

          <h3 class="section-subtitle" id="dissertation">Dissertation</h3>
          {% bibliography --query @phdthesis --group_by none %}
        </div>
      </section>

      <!-- Patents -->
      {% if site.data.patents and site.data.patents.size > 0 %}
        <section id="patents" class="home-section reveal">
          <h2 class="section-title">Patents</h2>
          <div class="publications">
            <ol class="bibliography">
              {% for patent in site.data.patents %}
                <li>
                  <div class="row">
                    <div class="col-sm-10">
                      <div class="title">{{ patent.title }}</div>
                      <div class="author">
                        {% for inv in patent.inventors %}
                          {% if forloop.last and forloop.length > 1 %}and {% endif %}
                          {% if inv == 'Mayank Rathee' -%}
                            <em>{{ inv }}</em>
                          {%- else -%}
                            {{- inv -}}
                          {%- endif %}
                          {%- unless forloop.last or forloop.length == 2 %}, {% endunless %}
                        {% endfor %}
                      </div>
                      <div class="periodical">
                        {{ patent.number -}}
                        {%- if patent.assignee %} · {{ patent.assignee }}{% endif %}
                        {%- if patent.granted %} · Granted {{ patent.granted }}{% elsif patent.filed %} · Filed {{ patent.filed }}{% endif %}
                      </div>
                      <div class="links">
                        {% if patent.abstract %}
                          <a class="abstract btn btn-sm z-depth-0" role="button">Abs</a>
                        {% endif %}
                        {% if patent.url %}
                          <a href="{{ patent.url }}" class="btn btn-sm z-depth-0" role="button">Google Patents</a>
                        {% endif %}
                      </div>
                      {% if patent.abstract %}
                        <div class="abstract hidden">
                          <p>{{ patent.abstract }}</p>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </li>
              {% endfor %}
            </ol>
          </div>
        </section>
      {% endif %}

      <!-- Talks: one toggle per paper -->
      {% if site.data.talks and site.data.talks.size > 0 %}
        <section id="talks" class="home-section reveal">
          <h2 class="section-title">Talks</h2>
          <ul class="talk-list">
            {% for talk in site.data.talks %}
              {% assign n = talk.venues | size %}
              <li class="talk">
                <button
                  class="talk-toggle"
                  type="button"
                  data-toggle="#talk-{{ forloop.index }}"
                  aria-expanded="false"
                  aria-controls="talk-{{ forloop.index }}"
                >
                  <span class="talk-title">{{ talk.title }}</span>
                  <span class="talk-meta">
                    {{ n }}
                    {% if n == 1 %}talk{% else %}talks{% endif %}
                    <i class="ti ti-chevron-down chev"></i>
                  </span>
                </button>
                <div class="collapsible" id="talk-{{ forloop.index }}">
                  <ul class="talk-venues">
                    {% for v in talk.venues %}
                      <li>
                        <span class="date">{{ v.date }}</span>
                        <span class="text">
                          {% if v.url %}
                            <a href="{{ v.url }}">
                              {{- v.venue }}
                              <i class="fa-solid fa-arrow-up-right-from-square"></i
                            ></a>
                          {% else %}
                            {{ v.venue }}
                          {% endif %}
                        </span>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </main>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
    <script defer src="{{ '/assets/js/home.js' | relative_url | bust_file_cache }}"></script>
  </body>
</html>
